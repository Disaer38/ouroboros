# Polymarket Bot — environment variables
# Copy to .env and fill in your values. Never commit .env to git.
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Optional: proxy for geo-bypass (HTTP, SOCKS5, SOCKS5h)
# Examples:
#   POLYMARKET_PROXY_URL=http://user:pass@proxy-host:8080
#   POLYMARKET_PROXY_URL=socks5://user:pass@1.2.3.4:1080
#   POLYMARKET_PROXY_URL=socks5h://user:pass@proxy-host:1080
POLYMARKET_PROXY_URL=
